{
  "model_version": "0.1.0",
  "schemas": [
    {
      "id": "beneficiario",
      "name": "Beneficiario",
      "fields": [
        {
          "name": "idade",
          "type": {
            "kind": "integer"
          },
          "required": true
        },
        {
          "name": "coeficiente_anterior",
          "type": {
            "kind": "number"
          },
          "required": true
        }
      ]
    },
    {
      "id": "contrato",
      "name": "Contrato coletivo",
      "fields": [
        {
          "name": "sinistralidade",
          "type": {
            "kind": "number"
          },
          "required": true
        },
        {
          "name": "vidas",
          "type": {
            "kind": "integer"
          },
          "required": true
        },
        {
          "name": "vcmh",
          "type": {
            "kind": "number"
          },
          "required": true
        },
        {
          "name": "meses_desde_ultimo_reajuste",
          "type": {
            "kind": "integer"
          },
          "required": true
        }
      ]
    }
  ],
  "decisions": [
    {
      "id": "reajuste_faixa_etaria",
      "name": "Reajuste por faixa etaria (ANS RN 63/2003)",
      "inputs": [
        {
          "name": "idade",
          "type": {
            "kind": "integer"
          },
          "required": true
        },
        {
          "name": "coeficiente_anterior",
          "type": {
            "kind": "number"
          },
          "required": true
        }
      ],
      "outputs": [
        {
          "name": "faixa",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "coeficiente",
          "type": {
            "kind": "number"
          }
        },
        {
          "name": "mudou_faixa",
          "type": {
            "kind": "boolean"
          }
        },
        {
          "name": "reajuste_faixa_pct",
          "type": {
            "kind": "number"
          }
        }
      ],
      "nodes": [
        {
          "type": "decision_table",
          "id": "classificacao",
          "hit_policy": "first",
          "inputs": [
            {
              "expr": "idade"
            }
          ],
          "outputs": [
            {
              "name": "faixa"
            },
            {
              "name": "coeficiente"
            }
          ],
          "rules": [
            {
              "id": "f1",
              "when": [
                "[0..18]"
              ],
              "then": [
                {
                  "value": "1 (0-18)"
                },
                {
                  "value": 1.0
                }
              ]
            },
            {
              "id": "f2",
              "when": [
                "[19..23]"
              ],
              "then": [
                {
                  "value": "2 (19-23)"
                },
                {
                  "value": 1.1
                }
              ]
            },
            {
              "id": "f3",
              "when": [
                "[24..28]"
              ],
              "then": [
                {
                  "value": "3 (24-28)"
                },
                {
                  "value": 1.2
                }
              ]
            },
            {
              "id": "f4",
              "when": [
                "[29..33]"
              ],
              "then": [
                {
                  "value": "4 (29-33)"
                },
                {
                  "value": 1.3
                }
              ]
            },
            {
              "id": "f5",
              "when": [
                "[34..38]"
              ],
              "then": [
                {
                  "value": "5 (34-38)"
                },
                {
                  "value": 1.4
                }
              ]
            },
            {
              "id": "f6",
              "when": [
                "[39..43]"
              ],
              "then": [
                {
                  "value": "6 (39-43)"
                },
                {
                  "value": 1.5
                }
              ]
            },
            {
              "id": "f7",
              "when": [
                "[44..48]"
              ],
              "then": [
                {
                  "value": "7 (44-48)"
                },
                {
                  "value": 1.65
                }
              ]
            },
            {
              "id": "f8",
              "when": [
                "[49..53]"
              ],
              "then": [
                {
                  "value": "8 (49-53)"
                },
                {
                  "value": 2.1
                }
              ]
            },
            {
              "id": "f9",
              "when": [
                "[54..58]"
              ],
              "then": [
                {
                  "value": "9 (54-58)"
                },
                {
                  "value": 2.7
                }
              ]
            },
            {
              "id": "f10",
              "when": [
                ">= 59"
              ],
              "then": [
                {
                  "value": "10 (59+)"
                },
                {
                  "value": 3.3
                }
              ]
            }
          ]
        },
        {
          "type": "expression",
          "id": "reaj",
          "output": "reajuste_calc",
          "expr": "if(coeficiente > coeficiente_anterior, coeficiente / coeficiente_anterior - 1, 0)"
        },
        {
          "type": "switch",
          "id": "mud",
          "output": "mudou_faixa",
          "cases": [
            {
              "when": "coeficiente > coeficiente_anterior",
              "then": {
                "value": true
              }
            }
          ],
          "default": {
            "value": false
          }
        },
        {
          "type": "output",
          "id": "out",
          "bindings": [
            {
              "output": "faixa",
              "value": {
                "expr": "faixa"
              }
            },
            {
              "output": "coeficiente",
              "value": {
                "expr": "coeficiente"
              }
            },
            {
              "output": "mudou_faixa",
              "value": {
                "expr": "mudou_faixa"
              }
            },
            {
              "output": "reajuste_faixa_pct",
              "value": {
                "expr": "reajuste_calc"
              }
            }
          ]
        }
      ],
      "tests": [
        {
          "name": "crianca na primeira faixa, sem reajuste",
          "given": {
            "idade": 10,
            "coeficiente_anterior": 1.0
          },
          "expect": {
            "faixa": "1 (0-18)",
            "coeficiente": 1.0,
            "mudou_faixa": false,
            "reajuste_faixa_pct": 0
          }
        },
        {
          "name": "entrou na segunda faixa (19-23) vindo da base",
          "given": {
            "idade": 19,
            "coeficiente_anterior": 1.0
          },
          "expect": {
            "faixa": "2 (19-23)",
            "coeficiente": 1.1,
            "mudou_faixa": true,
            "reajuste_faixa_pct": 0.1
          }
        },
        {
          "name": "reprecificacao para a setima faixa (44-48)",
          "given": {
            "idade": 45,
            "coeficiente_anterior": 1.0
          },
          "expect": {
            "faixa": "7 (44-48)",
            "coeficiente": 1.65,
            "mudou_faixa": true,
            "reajuste_faixa_pct": 0.65
          }
        },
        {
          "name": "ja na ultima faixa (59+), sem novo reajuste",
          "given": {
            "idade": 59,
            "coeficiente_anterior": 3.3
          },
          "expect": {
            "faixa": "10 (59+)",
            "coeficiente": 3.3,
            "mudou_faixa": false,
            "reajuste_faixa_pct": 0
          }
        }
      ]
    },
    {
      "id": "reajuste_coletivo",
      "name": "Reajuste de contrato coletivo",
      "inputs": [
        {
          "name": "sinistralidade",
          "type": {
            "kind": "number"
          },
          "required": true
        },
        {
          "name": "vidas",
          "type": {
            "kind": "integer"
          },
          "required": true
        },
        {
          "name": "vcmh",
          "type": {
            "kind": "number"
          },
          "required": true
        },
        {
          "name": "meses_desde_ultimo_reajuste",
          "type": {
            "kind": "integer"
          },
          "required": true
        }
      ],
      "outputs": [
        {
          "name": "faixa_risco",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "reajuste_pct",
          "type": {
            "kind": "number"
          }
        },
        {
          "name": "aprovacao_manual",
          "type": {
            "kind": "boolean"
          }
        }
      ],
      "nodes": [
        {
          "type": "decision_table",
          "id": "faixa",
          "hit_policy": "first",
          "inputs": [
            {
              "expr": "sinistralidade"
            }
          ],
          "outputs": [
            {
              "name": "faixa_risco"
            }
          ],
          "rules": [
            {
              "id": "r1",
              "when": [
                "<= 0.70"
              ],
              "then": [
                {
                  "value": "EQUILIBRADO"
                }
              ]
            },
            {
              "id": "r2",
              "when": [
                "<= 0.85"
              ],
              "then": [
                {
                  "value": "ATENCAO"
                }
              ]
            },
            {
              "id": "r3",
              "when": [
                "-"
              ],
              "then": [
                {
                  "value": "CRITICO"
                }
              ]
            }
          ]
        },
        {
          "type": "expression",
          "id": "excedente",
          "output": "excedente_sinistro",
          "expr": "if(sinistralidade > 0.70, sinistralidade - 0.70, 0)"
        },
        {
          "type": "expression",
          "id": "calc",
          "output": "reajuste_calc",
          "expr": "vcmh + excedente_sinistro"
        },
        {
          "type": "switch",
          "id": "alcada",
          "output": "aprovacao_manual",
          "cases": [
            {
              "when": "meses_desde_ultimo_reajuste < 12",
              "then": {
                "value": true
              }
            },
            {
              "when": "sinistralidade > 1.0",
              "then": {
                "value": true
              }
            },
            {
              "when": "reajuste_calc > 0.25",
              "then": {
                "value": true
              }
            }
          ],
          "default": {
            "value": false
          }
        },
        {
          "type": "output",
          "id": "out",
          "bindings": [
            {
              "output": "faixa_risco",
              "value": {
                "expr": "faixa_risco"
              }
            },
            {
              "output": "reajuste_pct",
              "value": {
                "expr": "reajuste_calc"
              }
            },
            {
              "output": "aprovacao_manual",
              "value": {
                "expr": "aprovacao_manual"
              }
            }
          ]
        }
      ],
      "tests": [
        {
          "name": "equilibrado, dentro do teto de alcada",
          "given": {
            "sinistralidade": 0.65,
            "vidas": 200,
            "vcmh": 0.12,
            "meses_desde_ultimo_reajuste": 12
          },
          "expect": {
            "faixa_risco": "EQUILIBRADO",
            "reajuste_pct": 0.12,
            "aprovacao_manual": false
          }
        },
        {
          "name": "atencao acima da alcada -> vai para Negociacao",
          "given": {
            "sinistralidade": 0.82,
            "vidas": 150,
            "vcmh": 0.14,
            "meses_desde_ultimo_reajuste": 14
          },
          "expect": {
            "faixa_risco": "ATENCAO",
            "reajuste_pct": 0.26,
            "aprovacao_manual": true
          }
        },
        {
          "name": "contrato deficitario e critico",
          "given": {
            "sinistralidade": 1.1,
            "vidas": 90,
            "vcmh": 0.15,
            "meses_desde_ultimo_reajuste": 18
          },
          "expect": {
            "faixa_risco": "CRITICO",
            "reajuste_pct": 0.55,
            "aprovacao_manual": true
          }
        },
        {
          "name": "dentro da carencia de 12 meses -> revisao manual",
          "given": {
            "sinistralidade": 0.6,
            "vidas": 300,
            "vcmh": 0.1,
            "meses_desde_ultimo_reajuste": 8
          },
          "expect": {
            "faixa_risco": "EQUILIBRADO",
            "reajuste_pct": 0.1,
            "aprovacao_manual": true
          }
        }
      ]
    }
  ],
  "workflows": [
    {
      "id": "reajuste_beneficiario",
      "name": "Reajuste do beneficiario (faixa etaria + contrato)",
      "start": "faixa",
      "steps": [
        {
          "type": "decision_task",
          "id": "faixa",
          "decision": "reajuste_faixa_etaria",
          "next": "contrato"
        },
        {
          "type": "decision_task",
          "id": "contrato",
          "decision": "reajuste_coletivo",
          "next": "gate"
        },
        {
          "type": "gateway",
          "id": "gate",
          "branches": [
            {
              "variable": "aprovacao_manual",
              "op": "eq",
              "value": true,
              "next": "aprovacao"
            }
          ],
          "default": "aplicar"
        },
        {
          "type": "human_task",
          "id": "aprovacao",
          "assignee": "negociacao",
          "next": "aplicar"
        },
        {
          "type": "service_task",
          "id": "aplicar",
          "action": "aplicar-reajuste",
          "next": "fim"
        },
        {
          "type": "end",
          "id": "fim"
        }
      ]
    }
  ],
  "test_suites": [],
  "environments": [],
  "releases": []
}